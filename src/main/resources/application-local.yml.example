# application-local.yml.example
# ==============================================
# 本地开发配置模板
# 使用步骤：
# 1.复制本文件，重命名为 application-local.yml
# 2.填充数据库密码、各类API密钥等敏感信息
# 3.application-local.yml 已加入 .gitignore，不会提交到Git
# ==============================================
spring:
  # mysql
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/ice_ai_code_mother
    username: root
    password: "请填写你的mysql数据库密码"

  # redis
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      username: default
      password: "请填写redis密码，无密码留空"
      database: 0
      ttl: 3600

# AI langchain4j
langchain4j:
  open-ai:
    chat-model:
      base-url: https://api.deepseek.com
      api-key: "请填入DeepSeek API‑Key"
      model-name: deepseek-chat
      max-tokens: 8192
      # strict-json-schema: true
      # response-format: json_object
      max-retries: 0
      log-requests: true
      log-responses: true

    streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: "请填入DeepSeek API‑Key"
      model-name: deepseek-chat
      max-tokens: 8192
      log-requests: true
      log-responses: true

    # 推理 AI 模型配置（用于复杂的推理任务）
    reasoning-streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: "请填入DeepSeek API‑Key"
      model-name: deepseek-reasoner
      max-tokens: 32768
      temperature: 0.1
      log-requests: true
      log-responses: true

    # 智能路由 AI 模型配置（用于简单的分类任务）
    routing-chat-model:
      base-url: https://api.deepseek.com
      api-key: "请填入DeepSeek API‑Key"
      model-name: deepseek-chat
      log-requests: true
      log-responses: true

# 添加 COS 对象存储配置（需要从腾讯云获取）
cos:
  client:
    host: https://ai-code-mother-1449956329.cos.ap-shanghai.myqcloud.com
    secretId: "填写腾讯云 secretId"
    secretKey: "填写腾讯云 secretKey"
    region: ap-shanghai
    bucket: ai-code-mother-1449956329

# Pexels 图片搜索配置
pexels:
  api-key: "填写Pexels api‑key"

# 阿里云 DashScope 配置
dashscope:
  api-key: "填写阿里云DashScope api‑key"
  image-model: wan2.2-t2i-flash
